HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://tv.example.com
PUBLIC_DOMAIN=tv.example.com
DATA_DIR=./data
ADMIN_API_KEY=replace-with-a-long-random-secret
TOKEN_HMAC_SECRET=replace-with-a-second-long-random-secret
DEFAULT_DEVICE_NAME=Living Room Samsung
DEFAULT_DEVICE_TOKEN=replace-with-a-third-long-random-secret
TV_MAX_PAGE_ITEMS=18
PLAYBACK_TTL_SECONDS=1800
CLOUDSTREAM_PROVIDER_ID=MovieBoxProvider
WORKER_URL=http://cloudstream-worker:8081
COMPAT_WORKER_URL=http://cloudstream-compat:8082

# Used only by the private Nuvio MovieBox bridge.
# Obtain your own TMDB API key and keep it out of Git.
TMDB_API_KEY=replace-with-your-tmdb-api-key

# Optional but recommended even though the bridge is private on Docker networks.
# Set the same value in the Nuvio container as NUVIO_MOVIEBOX_BRIDGE_TOKEN.
NUVIO_MOVIEBOX_BRIDGE_TOKEN=replace-with-a-long-random-bridge-token
