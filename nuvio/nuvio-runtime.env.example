# Private Docker service URL.
NUVIO_MOVIEBOX_BRIDGE_URL=http://nuvio-moviebox-bridge:8090

# Must match NUVIO_MOVIEBOX_BRIDGE_TOKEN in
# the bridge repository .env.
NUVIO_MOVIEBOX_BRIDGE_TOKEN=replace-with-random-secret

# Generic external providers.
# MovieBox intentionally does NOT appear here.
NUVIO_REPO_PROVIDERS=allwish,streamflix

NUVIO_REPOS=https://raw.githubusercontent.com/phisher98/phisher-nuvio-providers/refs/heads/main/,https://raw.githubusercontent.com/yoruix/nuvio-providers/refs/heads/main/
